<?xml version="1.0"?>
<!DOCTYPE look-and-feel PUBLIC "-//Liferay//DTD Look and Feel 7.3.0//EN" "http://www.liferay.com/dtd/liferay-look-and-feel_7_3_0.dtd">

<look-and-feel>
    <compatibility>
        <version>7.3.0+</version>
    </compatibility>

    <theme id="simple-liferay-theme" name="Simple Liferay Theme">
        <template-extension>ftl</template-extension>

        <!-- Theme Settings - Optional customizable settings -->
        <settings>
            <setting configurable="true" 
                     key="show-site-name" 
                     options="true,false" 
                     type="select" 
                     value="true" />

            <setting configurable="true" 
                     key="theme-color" 
                     type="text" 
                     value="#007bff" />
        </settings>

        <!-- Color schemes -->
        <color-scheme id="01" name="Blue">
            <default-cs>true</default-cs>
            <css-class>blue</css-class>
        </color-scheme>

        <color-scheme id="02" name="Green">
            <css-class>green</css-class>
        </color-scheme>

        <!-- Layout templates -->
        <layout-templates>
            <standard>
                <layout-template id="max" name="1 Column">
                    <template-path>/layouttpl/custom/max.tpl</template-path>
                    <wap-template-path>/layouttpl/custom/max.wap.tpl</wap-template-path>
                    <thumbnail-path>/layouttpl/custom/max.png</thumbnail-path>
                </layout-template>
            </standard>
        </layout-templates>

        <!-- Portlet decorators -->
        <portlet-decorator id="barebone" name="Barebone">
            <portlet-decorator-css-class>portlet-barebone</portlet-decorator-css-class>
        </portlet-decorator>

        <portlet-decorator id="borderless" name="Borderless">
            <portlet-decorator-css-class>portlet-borderless</portlet-decorator-css-class>
        </portlet-decorator>

        <portlet-decorator id="decorate" name="Decorate">
            <default-portlet-decorator>true</default-portlet-decorator>
            <portlet-decorator-css-class>portlet-decorate</portlet-decorator-css-class>
        </portlet-decorator>

        <portlet-decorator id="title" name="Title">
            <portlet-decorator-css-class>portlet-title</portlet-decorator-css-class>
        </portlet-decorator>
    </theme>
</look-and-feel>