<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>Simple Liferay Theme</display-name>

    <!-- Context parameters -->
    <context-param>
        <param-name>com.liferay.portal.kernel.servlet.PortletContextBag</param-name>
        <param-value>com.liferay.portal.kernel.servlet.PortletContextBagFactory</param-value>
    </context-param>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>