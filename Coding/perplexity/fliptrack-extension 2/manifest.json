{
  "manifest_version": 3,
  "name": "FlipTrack Pro - Price Tracker",
  "version": "1.0.0",
  "description": "Track Flipkart prices in real-time and save money with smart alerts",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.flipkart.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlipTrack Pro - Price Tracker"
  },
  "options_page": "options.html"
}